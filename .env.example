# Exemple sans valeur secrète. Ne jamais placer de données réelles ici.
APP_ENV=development

# Store : memory (défaut), sqlite (fichier local) ou d1 (Cloudflare Worker).
CAMPUS_STORE=memory
CAMPUS_SQLITE_PATH=.data/campus-agenda.sqlite

# Secret HMAC pour les cookies de session (et dérivation des codes élèves).
# Production : obligatoire, au moins 32 octets. 48 ou 64 caractères aléatoires recommandés.
#   openssl rand -base64 48
# Un secret faible (ex. AUTH_SECRET=1234) refuse le démarrage. Ne jamais logger la valeur.
# Hors production, une valeur fictive interne est utilisée si absent.
AUTH_SECRET=

# Chiffrement AES-GCM des secrets TOTP administrateur (et données MFA en sauvegarde).
# Production : obligatoire dès qu’un admin utilise la 2FA.
# Exactement 32 octets (64 caractères hexadécimaux acceptés).
#   openssl rand -hex 32
# Ne jamais committer la vraie valeur.
CAMPUS_MFA_ENCRYPTION_KEY=

# Alertes SMS de sécurité (canal d’alerte uniquement, jamais un facteur MFA).
# Désactivées hors production (local, test, CI). Les vraies valeurs se configurent
# dans la commande de lancement du site Node.js Infomaniak, jamais dans Git.
# Voir docs/SECURITY_SMS_ALERTS.md.
CAMPUS_SECURITY_SMS_ENABLED=false
# Numéro destinataire au format E.164 (ex. +41…). Ne jamais committer le vrai numéro.
CAMPUS_SECURITY_SMS_TO=
# Fournisseur : twilio (seul fournisseur pris en charge).
CAMPUS_SMS_PROVIDER=
CAMPUS_SMS_TWILIO_ACCOUNT_SID=
CAMPUS_SMS_TWILIO_AUTH_TOKEN=
# Expéditeur : numéro E.164, identifiant alphanumérique ou Messaging Service SID (MG…).
CAMPUS_SMS_TWILIO_FROM=

# Alertes e-mail de sécurité (SMTP Infomaniak, canal d’alerte uniquement).
# Désactivées hors production. Les vraies valeurs se configurent dans la
# commande de lancement Infomaniak, jamais dans Git. Voir docs/SECURITY_EMAIL_ALERTS.md.
CAMPUS_SECURITY_EMAIL_ENABLED=false
CAMPUS_SECURITY_EMAIL_TO=
CAMPUS_SECURITY_EMAIL_FROM=
CAMPUS_SMTP_HOST=
CAMPUS_SMTP_PORT=
CAMPUS_SMTP_USER=
CAMPUS_SMTP_PASSWORD=
